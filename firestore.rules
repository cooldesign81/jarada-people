rules_version = '2';

// ============================================================
// JARADA People — Firestore 보안규칙 v0.2
//
// v0.1(기존 게시본)을 그대로 이어받고, 직원·조직 관리 앱에 필요한 부분을 합쳤다.
//
// 전제 1) 권한은 roles/{uid} 문서 한 장으로 결정한다.
//         { level: 'super'|'hr'|'edu'|'principal'|'manager'|'lead'|'admin'|'staff',
//           orgId: 'hq', employeeId: 'emp_0001' }
//         · super          대표 — 전체
//         · hr / edu       본사 인사 / 교육팀 — 모든 지점
//         · admin / principal  지점 관리자·원장 — 소속 지점 직원을 등록·수정 (admin 은 앱이 쓰는 이름)
//         · manager        실장 — 소속 지점 직원 읽기
//         · staff          직원 — 본인 정보
// 전제 2) 삭제는 원칙적으로 금지. 상태 변경으로 처리한다.
//         (예외: 대표가 직원 정보를 완전 삭제하는 것만 허용)
// 전제 3) 앱이 쓰는 경로
//         roles/{uid}                          권한 (+ 이메일 셀프 등록, 등록 링크 셀프 등록)
//         orgs/{orgId}                         지점
//         meta/counters                        사번 카운터
//         employees/{id}                       직원 기본 정보 (orgIds[] 복수 지점, orgId = 대표 지점)
//         employees/{id}/private/personalInfo  주소·계좌·보호자·각종 날짜
//         employees/{id}/private/residentFront|residentBack  주민등록번호 앞/뒤  ※ 아래 보안 참고
//         employees/{id}/private/compensation  급여 (대표 전용)
//         employees/{id}/private/flags         등록 여부 표시
//
// 보안 참고) residentFront/Back 은 현재 앱이 평문으로 저장한다(jarada-hr 와 동일).
//   v0.1 의 방침(암호화 보관, 클라이언트 접근 전면 차단)과 다르다.
//   방침대로 가려면 아래 residentFront/residentBack 줄을 지우고 Cloud Functions 로 옮길 것.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 헬퍼 ----------
    function signedIn() {
      return request.auth != null;
    }
    function myEmail() {
      return request.auth.token.get('email', '').lower();
    }
    function rolePath() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }
    function hasRole() {
      return signedIn() && exists(rolePath());
    }

    // 같은 요청 안에서 같은 문서를 여러 번 get() 해도 1회로 캐시된다
    function me() {
      return get(rolePath()).data;
    }

    function isSuper() {
      return hasRole() && me().level == 'super';
    }

    function isHR() {
      return hasRole() && me().level in ['super', 'hr'];
    }

    // 교육팀: 교육과정 / 자격 / 학회 관리
    function isEdu() {
      return hasRole() && me().level in ['super', 'hr', 'edu'];
    }

    // 지점 관리자 계열 (읽기): 원장 / 실장 / admin
    function isOrgMgr() {
      return hasRole() && me().level in ['admin', 'principal', 'manager', 'lead'];
    }

    // 지점 관리자 계열 (쓰기): 원장 / admin
    function isOrgAdmin() {
      return hasRole() && me().level in ['admin', 'principal'];
    }

    // 해당 지역원의 원장 또는 실장
    function isManagerOf(orgId) {
      return isOrgMgr() && me().orgId == orgId;
    }

    // ---------- 등급별 권한 설정 (관리 → 권한 설정, settings/permissions) ----------
    // 문서가 없거나 항목이 없으면 기본값(def)을 쓴다. 최고관리자는 항상 허용.
    // capAll: 전체 지점을 다루는 대표이사(hr) / capBranch: 소속 지점만 다루는 등급(levels 안에서 설정에 든 경우)
    function permPath() {
      return /databases/$(database)/documents/settings/permissions;
    }
    function permList(cap, def) {
      return exists(permPath()) ? get(permPath()).data.get(cap, def) : def;
    }
    function capAll(cap, def) {
      return isSuper() || (hasRole() && me().level == 'hr' && 'hr' in permList(cap, def));
    }
    function capBranch(cap, def, levels) {
      return hasRole() && me().level in levels && me().level in permList(cap, def);
    }

    function isPrincipalOf(orgId) {
      return isOrgAdmin() && me().orgId == orgId;
    }

    // 등록 링크로 만든 권한(selfToken 이 있는 roles)은 직원 문서의 링크가 아직 유효할 때만 본인으로 인정한다.
    // 링크를 폐기(selfToken 삭제)하거나 만료일이 지나면 이미 접속한 사람도 바로 막힌다.
    function selfTokenValid(empId) {
      return !('selfToken' in me())
        || (get(empPath(empId)).data.get('selfToken', '') == me().selfToken
            && get(empPath(empId)).data.get('selfTokenExpires', request.time) >= request.time);
    }
    function isSelf(empId) {
      return hasRole() && me().get('employeeId', '') == empId && selfTokenValid(empId);
    }

    function empPath(id) {
      return /databases/$(database)/documents/employees/$(id);
    }
    function orgExists(id) {
      return exists(/databases/$(database)/documents/orgs/$(id));
    }
    // 직원 문서의 소속 지점 목록 (orgIds 가 없던 예전 문서는 orgId 하나로 취급)
    function orgsOf(d) {
      return d.get('orgIds', [d.get('orgId', '')]);
    }
    function orgMgrOfEmp(id) {
      return isOrgMgr() && exists(empPath(id)) && me().orgId in orgsOf(get(empPath(id)).data);
    }
    function orgAdminOfEmp(id) {
      return isOrgAdmin() && exists(empPath(id)) && me().orgId in orgsOf(get(empPath(id)).data);
    }

    // 대표가 설정에서 ‘주민번호 뒷자리 수집 안 함’으로 바꾸면 새로 저장할 수 없다 (기존 값 삭제는 가능)
    function rrnBackAllowed() {
      return !exists(/databases/$(database)/documents/settings/app)
        || get(/databases/$(database)/documents/settings/app).data.get('rrnBackEnabled', true) != false;
    }

    function validLevel(l) {
      return l in ['super', 'hr', 'edu', 'principal', 'manager', 'lead', 'admin', 'staff'];
    }
    function validStatus(s) {
      return s in ['active', 'leave', 'resigned'];
    }
    // 지점 관리자가 부여할 수 있는 등급 (본사 등급은 불가)
    function orgLevel(l) {
      return l in ['staff', 'lead', 'manager', 'admin', 'principal'];
    }

    function validEmployee() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.email is string && d.email == d.email.lower() && d.email.size() <= 254
        && d.orgIds is list && d.orgIds.size() >= 1 && d.orgId == d.orgIds[0] && orgExists(d.orgId)
        && validLevel(d.level)
        && validStatus(d.status)
        && d.get('birthDate', '') is string
        && (d.get('birthDate', '') == '' || d.get('birthDate', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && d.get('annualAdjust', 0) is number && d.get('annualAdjust', 0) >= -100 && d.get('annualAdjust', 0) <= 100
        && (d.get('probationEndDate', '') == '' || d.get('probationEndDate', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.get('contractEndDate', '') == '' || d.get('contractEndDate', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function validOrg() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.type in ['hq', 'branch']
        && d.active is bool;
    }

    // ---------- 권한 마스터 ----------
    match /roles/{uid} {
      // 본인 권한은 본인이 읽을 수 있어야 앱이 메뉴를 그린다
      allow get: if signedIn() && request.auth.uid == uid;
      allow read: if isHR() || (isOrgAdmin() && resource.data.orgId == me().orgId);

      // 셀프 등록 ①: 로그인 이메일과 일치하는 직원 문서가 있고, 퇴직 상태가 아닐 때
      // level/orgId/employeeId 가 그 직원 문서와 정확히 같아야 한다
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['level', 'orgId', 'employeeId'])
        && request.resource.data.employeeId is string
        && exists(empPath(request.resource.data.employeeId))
        && get(empPath(request.resource.data.employeeId)).data.email == myEmail()
        && get(empPath(request.resource.data.employeeId)).data.status != 'resigned'
        && request.resource.data.level == get(empPath(request.resource.data.employeeId)).data.level
        && request.resource.data.orgId == get(empPath(request.resource.data.employeeId)).data.orgId;

      // 셀프 등록 ②: 등록 링크(?self=사번&t=토큰). 직원 문서의 selfToken 과 일치해야 하고 항상 ‘직원’ 등급
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['level', 'employeeId', 'selfToken'])
        && request.resource.data.level == 'staff'
        && request.resource.data.employeeId is string
        && exists(empPath(request.resource.data.employeeId))
        && get(empPath(request.resource.data.employeeId)).data.get('selfToken', '') != ''
        && get(empPath(request.resource.data.employeeId)).data.get('selfToken', '') == request.resource.data.selfToken
        && get(empPath(request.resource.data.employeeId)).data.get('selfTokenExpires', request.time) >= request.time
        && get(empPath(request.resource.data.employeeId)).data.status != 'resigned';

      allow create, update, delete: if isSuper();

      // 본사 인사: 최고관리자 등급은 건드릴 수 없다
      allow create: if isHR() && request.resource.data.level != 'super';
      allow update: if isHR()
        && resource.data.level != 'super' && request.resource.data.level != 'super';
      allow delete: if isHR() && resource.data.level != 'super';

      // 지점 관리자: 같은 지점의 본사 등급이 아닌 권한만 수정/삭제 (승격 불가)
      allow update: if isOrgAdmin()
        && resource.data.orgId == me().orgId && orgLevel(resource.data.level)
        && request.resource.data.orgId == me().orgId && orgLevel(request.resource.data.level);
      allow delete: if isOrgAdmin()
        && resource.data.orgId == me().orgId && orgLevel(resource.data.level);
    }

    // ---------- 조직 ----------
    match /orgs/{orgId} {
      allow read: if signedIn();
      allow create, update: if isHR() && validOrg();
      allow delete: if isSuper();
    }

    // ---------- 앱 설정 (대표만 변경) ----------
    //   rrnBackEnabled: 주민번호 뒷자리 수집 여부, linkDays: 등록 링크 기본 유효일
    match /settings/{docId} {
      allow read: if hasRole();
      allow write: if isSuper();
    }

    // ---------- 사번 카운터 ----------
    match /meta/{docId} {
      allow read, write: if isHR() || isOrgAdmin();
    }

    // ---------- 직원: 공개 인사정보 ----------
    // 이름 / 사번 / 소속 / 직군 / 직급 / 입사일 / 재직상태 / 사진
    // 민감정보는 절대 이 문서에 넣지 않는다.
    match /employees/{empId} {
      // 휴지통 표시(deleted 등)를 바꾸는 수정인가
      function trashFieldsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(['deleted', 'deletedAt', 'deletedBy']);
      }
      // 읽기: 본사 / 소속 지점 관리자 / 본인(권한 연결 후, 또는 이메일 일치)
      allow read: if signedIn() && (
        isHR()
        || (isOrgMgr() && (resource.data.orgId == me().orgId || me().orgId in resource.data.orgIds))
        || isSelf(empId)
        || resource.data.email == myEmail()
      );

      // 대표: 모든 등급 부여 가능 / 본사 인사: 최고관리자 등급만 제외
      allow create, update: if isSuper() && validEmployee();
      // (관리 → 권한 설정에서 대표이사·원장·부원장의 ‘직원 등록·수정’, 대표이사의 ‘삭제’를 끌 수 있다)
      allow create: if capAll('empWrite', ['hr', 'principal', 'admin']) && validEmployee() && request.resource.data.level != 'super';
      allow update: if capAll('empWrite', ['hr', 'principal', 'admin']) && validEmployee()
        && resource.data.level != 'super' && request.resource.data.level != 'super'
        && (!trashFieldsChanged() || capAll('trash', ['hr']));

      // 지점 관리자: 소속 지점 안에서만, 본사 등급은 생성/수정 불가, 지점 목록은 바꿀 수 없음
      allow create: if capBranch('empWrite', ['hr', 'principal', 'admin'], ['principal', 'admin']) && validEmployee()
        && request.resource.data.orgIds == [me().orgId]
        && orgLevel(request.resource.data.level);
      allow update: if capBranch('empWrite', ['hr', 'principal', 'admin'], ['principal', 'admin']) && validEmployee()
        && !trashFieldsChanged()
        && me().orgId in orgsOf(resource.data)
        && request.resource.data.orgIds == orgsOf(resource.data)
        && request.resource.data.orgId == resource.data.get('orgId', request.resource.data.orgId)
        && orgLevel(resource.data.level) && orgLevel(request.resource.data.level);

      allow delete: if isSuper();   // 퇴사는 status 변경이 원칙. 완전 삭제는 대표만 (하위 문서·파일은 앱이 함께 정리)

      // ---------- 개인 정보 / 주민등록번호 앞뒤 / 급여 (앱 사용) ----------
      match /private/{docId} {
        function managerOf() { return isHR() || orgAdminOfEmp(empId); }
        function ownerOrManager() { return isSelf(empId) || managerOf(); }
        function validPersonal() {
          let d = request.resource.data;
          return d.keys().hasOnly(['address', 'bankAccount', 'guardianName', 'guardianRelation', 'guardianPhone',
                                   'eduStartDate', 'workStartDate', 'insuranceRegDate', 'resignDate', 'updatedAt'])
            && d.get('address', '') is string && d.get('address', '').size() <= 200
            && d.get('bankAccount', '') is string && d.get('bankAccount', '').size() <= 200
            && d.get('guardianName', '') is string && d.get('guardianName', '').size() <= 200
            && d.get('guardianRelation', '') is string && d.get('guardianRelation', '').size() <= 200
            && d.get('guardianPhone', '') is string && d.get('guardianPhone', '').size() <= 200;
        }
        function validRrnFront() { return request.resource.data.value is string && request.resource.data.value.matches('^[0-9]{6}$'); }
        function validRrnBack()  { return request.resource.data.value is string && request.resource.data.value.matches('^[0-9]{7}$'); }

        allow read: if (docId in ['personalInfo', 'flags', 'residentFront'] && ownerOrManager())
                    || (docId == 'residentBack' && capAll('rrnBack', []))
                    || (docId == 'compensation' && capAll('comp', []));

        allow create, update: if (docId == 'personalInfo' && ownerOrManager() && validPersonal())
                              || (docId == 'flags' && ownerOrManager())
                              || (docId == 'residentFront' && ownerOrManager() && validRrnFront())
                              || (docId == 'residentBack' && (capAll('rrnBack', []) || isSelf(empId)) && validRrnBack() && rrnBackAllowed())
                              || (docId == 'compensation' && capAll('comp', []));

        // 삭제는 대표만 (직원 완전 삭제 시 정리용)
        allow delete: if isSuper();
      }

      // ---------- 민감: 신원 / 계좌 / 주소 (v0.1, 앱 미사용) ----------
      // 직원 본인과 본사 HR만. 원장도 볼 수 없다.
      // 주민등록번호는 여기에 마스킹값(901231-1******)만 둔다.
      match /private/identity {
        allow read: if isSelf(empId) || isHR();
        allow write: if isHR();   // 본인 수정은 changeRequests 경유
      }

      // ---------- 최고민감: 주민등록번호 암호문 ----------
      // 개인정보보호법상 주민등록번호는 암호화 보관이 의무다.
      // 브라우저에는 복호화 키를 둘 수 없으므로 이 문서는
      // 클라이언트에서 읽기·쓰기 모두 전면 차단한다.
      // 접근은 Cloud Functions(Admin SDK)만 가능하며,
      // Admin SDK는 보안규칙을 우회하므로 아래 false가 서버를 막지는 않는다.
      match /secure/{secureDoc} {
        allow read, write: if false;
      }

      // ---------- 대표 전용: 퇴직금 중간정산 (v0.1, 앱 미사용 — 앱은 compensation 에 함께 저장) ----------
      match /private/severance {
        allow read, write: if isSuper();
      }

      // 아래 하위 기록들의 읽기 권한은 문서가 아니라 ‘부모 직원’ 기준이다 (목록 조회가 가능하도록).

      // ---------- 발령·변경 이력 ----------
      match /assignments/{assignmentId} {
        function validAssignment() {
          let d = request.resource.data;
          return d.type in ['transfer', 'position', 'level', 'status', 'other']
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.get('from', '') is string && d.get('from', '').size() <= 100
            && d.get('to', '') is string && d.get('to', '').size() <= 100
            && d.get('note', '') is string && d.get('note', '').size() <= 500;
        }
        allow read: if isSelf(empId) || isHR() || orgMgrOfEmp(empId);
        allow create: if (isHR() || orgAdminOfEmp(empId)) && validAssignment();
        allow update: if isHR() && validAssignment();
        allow delete: if isSuper();
      }

      // ---------- 자격증 ----------
      match /certs/{certId} {
        function validCert() {
          let d = request.resource.data;
          return d.name is string && d.name.size() > 0 && d.name.size() <= 60
            && d.get('number', '') is string && d.get('number', '').size() <= 60
            && d.get('issuer', '') is string && d.get('issuer', '').size() <= 60
            && (d.get('issuedDate', '') == '' || d.get('issuedDate', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
            && (d.get('expiresDate', '') == '' || d.get('expiresDate', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
            && d.get('note', '') is string && d.get('note', '').size() <= 300;
        }
        allow read: if isSelf(empId) || isEdu() || orgMgrOfEmp(empId);
        allow create, update: if (isEdu() || orgAdminOfEmp(empId)) && validCert();
        allow delete: if isEdu() || orgAdminOfEmp(empId);
      }

      // ---------- 교육 / 학회 이수 ----------
      // 규정상 학회보고서의 적용점은 교사가 직접 작성한다.
      // 따라서 확정(approved) 전까지는 본인이 쓰고 고칠 수 있다.
      match /enrollments/{enrollmentId} {
        function validEnrollment() {
          let d = request.resource.data;
          return d.title is string && d.title.size() > 0 && d.title.size() <= 100
            && d.kind in ['training', 'conference', 'other']
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.get('hours', 0) is number && d.get('hours', 0) >= 0 && d.get('hours', 0) <= 1000
            && d.status in ['draft', 'submitted', 'approved']
            && d.get('report', '') is string && d.get('report', '').size() <= 3000;
        }
        allow read: if isSelf(empId) || isEdu() || orgMgrOfEmp(empId);
        allow create: if (isSelf(empId) || isEdu() || orgAdminOfEmp(empId))
                      && request.resource.data.status == 'draft' && validEnrollment();
        allow update: if (isEdu() && validEnrollment())
                      || (isSelf(empId)
                          && resource.data.status != 'approved'
                          && request.resource.data.status in ['draft', 'submitted']
                          && validEnrollment());
        allow delete: if isEdu() || (isSelf(empId) && resource.data.status == 'draft');
      }

      // ---------- 면담 / 평가 ----------
      // visibility: 'shared'(직원 열람 가능) | 'manager'(관리자 전용) | 'hr'(본사 전용)
      match /reviews/{reviewId} {
        function validReview() {
          let d = request.resource.data;
          return d.kind in ['interview', 'evaluation', 'other']
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.title is string && d.title.size() > 0 && d.title.size() <= 100
            && d.get('content', '') is string && d.get('content', '').size() <= 5000
            && d.visibility in ['shared', 'manager', 'hr']
            && d.get('score', 0) is number && d.get('score', 0) >= 0 && d.get('score', 0) <= 100;
        }
        allow read: if isHR()
                    || (orgMgrOfEmp(empId) && resource.data.visibility in ['shared', 'manager'])
                    || (isSelf(empId) && resource.data.visibility == 'shared');
        allow create: if (isHR() || orgMgrOfEmp(empId)) && validReview();
        allow update: if (isHR() || (orgMgrOfEmp(empId) && resource.data.visibility in ['shared', 'manager'])) && validReview();
        allow delete: if isHR() || (orgMgrOfEmp(empId) && resource.data.get('createdBy', '') == request.auth.uid);
      }

      // ---------- 급여 변경 이력 (대표 전용) ----------
      match /compHistory/{historyId} {
        allow read, create: if capAll('comp', []);
        allow update: if false;
        allow delete: if isSuper();
      }

      // ---------- 증명서 발급 이력 ----------
      match /certIssues/{issueId} {
        function validIssue() {
          let d = request.resource.data;
          return d.no is string && d.no.matches('^JP-[0-9]{4}-[0-9]+$')
            && d.type in ['current', 'career']
            && d.issuedDate is string && d.issuedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        }
        allow read: if isHR() || orgAdminOfEmp(empId);
        allow create: if (isHR() || orgAdminOfEmp(empId)) && validIssue();
        allow delete: if isSuper();
      }

      // ---------- 문서 메타 (실제 파일은 Storage) ----------
      match /docs/{docId} {
        allow read: if isSelf(empId) || isHR();
        allow create: if isSelf(empId) || isHR();
        allow update: if isHR();
        allow delete: if false;
      }
    }

    // ---------- 접근 요청 ----------
    // 권한 없는 계정이 로그인하면 본인 UID로 요청을 남긴다.
    // 대표는 이 목록을 보고 권한을 부여한다.
    match /accessRequests/{uid} {
      allow read: if isHR() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if isHR();
    }

    // ---------- 본인 정보 변경 요청 ----------
    // 직원이 주소·연락처·계좌를 직접 고치는 대신 요청을 남기고 HR이 반영한다.
    match /changeRequests/{requestId} {
      allow read: if isHR() || isSelf(resource.data.employeeId);
      allow create: if isSelf(request.resource.data.employeeId)
                    && request.resource.data.status == 'submitted';
      allow update: if isHR();
      allow delete: if false;
    }

    // ---------- 휴가 ----------
    // 승인함에서 지점별로 모아 봐야 하므로 최상위에 둔다.
    // 직원 본인이 신청(submitted)하고, 지점 관리자·본사가 승인/반려한다. 본인 신청은 본인이 승인할 수 없다(대표 제외).
    match /leaveRequests/{requestId} {
      function leaveMgr(d) { return isOrgMgr() && (d.orgId == me().orgId || me().orgId in d.orgIds); }
      function validLeave() {
        let d = request.resource.data;
        return d.employeeId is string && exists(empPath(d.employeeId))
          && d.employeeName is string && d.employeeName.size() <= 40
          && d.orgId == get(empPath(d.employeeId)).data.orgId
          && d.orgIds is list && d.orgIds == orgsOf(get(empPath(d.employeeId)).data)
          && d.type in ['annual', 'half_am', 'half_pm', 'sick', 'family', 'official', 'childcare', 'other']
          && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.endDate is string && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.endDate >= d.startDate
          && d.days is number && d.days >= 0 && d.days <= 365
          && d.get('reason', '') is string && d.get('reason', '').size() <= 500;
      }

      allow read: if isHR()
                  || isSelf(resource.data.employeeId)
                  || leaveMgr(resource.data);

      allow create: if isSelf(request.resource.data.employeeId)
                    && request.resource.data.status == 'submitted'
                    && validLeave();
      // 관리자가 직원 대신 등록 (바로 승인 가능)
      allow create: if (isHR() || orgAdminOfEmp(request.resource.data.employeeId))
                    && request.resource.data.status in ['submitted', 'approved']
                    && validLeave();

      // 승인·반려·취소 처리
      allow update: if (capAll('leaveApprove', ['hr', 'principal', 'admin', 'manager', 'lead'])
                        || (leaveMgr(resource.data) && me().level in permList('leaveApprove', ['hr', 'principal', 'admin', 'manager', 'lead'])))
                    && (resource.data.employeeId != me().get('employeeId', '') || isSuper())
                    && request.resource.data.status in ['submitted', 'approved', 'rejected', 'cancelled']
                    && request.resource.data.days is number && request.resource.data.days >= 0 && request.resource.data.days <= 365
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'days', 'decisionNote', 'decidedBy', 'decidedByName', 'decidedAt', 'updatedAt']);

      // 본인: 승인 전에는 고치거나 취소할 수 있다
      allow update: if isSelf(resource.data.employeeId)
                    && resource.data.status == 'submitted'
                    && request.resource.data.status in ['submitted', 'cancelled']
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'type', 'startDate', 'endDate', 'days', 'reason', 'updatedAt'])
                    && validLeave();

      allow delete: if isSuper();
    }

    // ---------- 달력 일정 (휴일·행사·교육) ----------
    // orgIds 가 비어 있으면 전체 지점. 지점 관리자는 자기 지점 일정만 다룬다.
    match /calendarEvents/{eventId} {
      function validEvent() {
        let d = request.resource.data;
        return d.title is string && d.title.size() > 0 && d.title.size() <= 60
          && d.kind in ['holiday', 'event', 'training']
          && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.endDate is string && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.endDate >= d.startDate
          && d.orgIds is list && d.orgIds.size() <= 20;
      }
      allow read: if hasRole();
      allow create, update: if isHR() && validEvent();
      allow create: if isOrgAdmin() && validEvent() && request.resource.data.orgIds == [me().orgId];
      allow update: if isOrgAdmin() && validEvent()
                    && resource.data.orgIds == [me().orgId] && request.resource.data.orgIds == [me().orgId];
      allow delete: if isHR() || (isOrgAdmin() && resource.data.orgIds == [me().orgId]);
    }

    // ---------- 공지사항 ----------
    // scope 'all' = 전체, 'org' = orgIds 에 든 지점 (대표 지점 기준). 쓰기는 본사 인사 또는 지점 관리자(자기 지점 공지만)
    match /notices/{noticeId} {
      function validNotice() {
        let d = request.resource.data;
        return d.title is string && d.title.size() > 0 && d.title.size() <= 80
          && d.body is string && d.body.size() > 0 && d.body.size() <= 5000
          && d.scope in ['all', 'org']
          && d.orgIds is list && d.orgIds.size() <= 20
          && (d.scope == 'all' ? d.orgIds.size() == 0 : d.orgIds.size() > 0)
          && d.get('pinned', false) is bool;
      }
      allow read: if hasRole() && (isHR() || resource.data.scope == 'all' || me().orgId in resource.data.orgIds);
      allow create: if (capAll('noticeWrite', ['hr', 'principal', 'admin']) || (capBranch('noticeWrite', ['hr', 'principal', 'admin'], ['principal', 'admin']) && request.resource.data.scope == 'org' && request.resource.data.orgIds == [me().orgId]))
                    && validNotice() && request.resource.data.createdBy == request.auth.uid;
      allow update: if (capAll('noticeWrite', ['hr', 'principal', 'admin']) || (capBranch('noticeWrite', ['hr', 'principal', 'admin'], ['principal', 'admin']) && resource.data.scope == 'org' && resource.data.orgIds == [me().orgId]
                                   && request.resource.data.scope == 'org' && request.resource.data.orgIds == [me().orgId]))
                    && validNotice() && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if capAll('noticeWrite', ['hr', 'principal', 'admin']) || (capBranch('noticeWrite', ['hr', 'principal', 'admin'], ['principal', 'admin']) && resource.data.scope == 'org' && resource.data.orgIds == [me().orgId]);
    }

    // 사용자별 읽은 공지 목록. 본인만 쓰고, 읽음 현황은 본사 인사 / 같은 지점 관리자가 본다
    match /noticeReads/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isHR() || (isOrgAdmin() && resource.data.orgId == me().orgId));
      allow create, update: if hasRole() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['reads', 'employeeId', 'name', 'orgId', 'updatedAt'])
                            && request.resource.data.reads is map
                            && request.resource.data.employeeId == me().get('employeeId', '')
                            && request.resource.data.orgId == me().get('orgId', '');
      allow delete: if isSuper();
    }

    // ---------- 교육과정 마스터 ----------
    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if isEdu();
    }

    // ---------- 감사로그 ----------
    // 생성만 가능. 수정·삭제는 누구도 할 수 없다.
    match /auditLogs/{logId} {
      allow read: if capAll('audit', ['hr']);
      allow create: if signedIn()
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ---------- 기본 차단 ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
